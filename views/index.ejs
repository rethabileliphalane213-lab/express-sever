<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
      <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1><%= title %></h1>

    <ul>
        <% if (users && users.length > 0) { %>
            <% users.forEach(user => { %>
                <li>
                    ID: <%= user.id %>,
                    Name: <%= user.firstName %> <%= user.lastName %>,
                    Email: <%= user.email %>,
                    Age: <%= user.age %>,
                    Bio: <%= user.bio %>

                    <br>

                    <a href="/<%= user.id %>/update">Update</a>

                    <form action="/<%= user.id %>/delete" method="POST" style="display:inline;">
                        <button type="submit">
                            Delete
                        </button>
                    </form>
                </li>
            <% }) %>
        <% } else { %>
            <li>No users found</li>
        <% } %>
    </ul>

    <a href="/create" id="create">Create</a>
    <a href="/searchUser" id="searchUser">Search User</a>
</body>
</html>