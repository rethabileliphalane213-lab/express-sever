<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
      <link rel="stylesheet" href="/styles.css">
</head>
<body>

<h1><%= title %></h1>

<ul>
    <% if (users && users.length > 0) { %>
        <% users.forEach(user => { %>
            <li>
                <%= user.firstName %> <%= user.lastName %> -
                <%= user.email %>
            </li>
        <% }) %>
    <% } else { %>
        <li>No users found</li>
    <% } %>
</ul>

<a href="/" class="home">Back to Home</a>

</body>
</html>